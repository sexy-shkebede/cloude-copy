# Токен бота от @BotFather
BOT_TOKEN=

# Цена одной оценки в звёздах Telegram
PRICE_STARS=10

# Бесплатные оценки для новых пользователей (0 — без бонуса)
WELCOME_BONUS=0

# Дополнительные админы через запятую (главный админ 7185631660 прописан в config.py)
ADMIN_IDS=

# Админы оценивают себя бесплатно (1 — да, 0 — нет)
ADMIN_FREE=1

# Ссылка на мини-приложение (https://...). Пусто — кнопка показывает «скоро»
MINI_APP_URL=

# Название на картинках (карточка результата)
BOT_BRAND=I WANNA MOG YOU

# Картинка приветствия после /start (по умолчанию assets/banner.jpg).
# Цена на ней нарисована, поэтому при смене PRICE_STARS замени и картинку
BANNER_PATH=

# Сколько анализов выполнять одновременно (на телефоне лучше 1)
ANALYSIS_WORKERS=1

# Папка с базой, фото оценок и логом (по умолчанию data рядом с bot.py)
DATA_DIR=
